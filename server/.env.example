# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/svpmpc-multi-module

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Session Configuration
SESSION_SECRET=your-session-secret-change-this-in-production

# ============================================
# SETUP INSTRUCTIONS
# ============================================

# 1. Copy this file to .env:
#    cp .env.example .env

# 2. Update the values above with your actual credentials

# 3. Generate secure secrets:
#    - JWT_SECRET: Use a long random string
#    - SESSION_SECRET: Use a different long random string
#    - You can generate them using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ============================================
# NOTES
# ============================================

# - Never commit the .env file to version control
# - Keep your credentials secure
# - Use different secrets for development and production
