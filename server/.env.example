# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/svpmpc-multi-module

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# Email Configuration (for sending member credentials)
# Using Gmail (recommended for testing)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-digit-app-password

# Application URL (for email links)
APP_URL=http://localhost:5173

# SMS Configuration (Optional - for sending credentials via SMS)
# Using Semaphore SMS (Philippine SMS provider)
# Sign up at: https://semaphore.co/
SEMAPHORE_API_KEY=your-semaphore-api-key-here
SMS_SENDER_NAME=SVPMPC

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Session Configuration
SESSION_SECRET=your-session-secret-change-this-in-production

# ============================================
# SETUP INSTRUCTIONS
# ============================================

# 1. Copy this file to .env:
#    cp .env.example .env

# 2. Update the values above with your actual credentials

# 3. For Gmail Email Setup:
#    - Go to Google Account Settings
#    - Security → 2-Step Verification → App Passwords
#    - Generate a new app password for "Mail"
#    - Use that 16-digit password in EMAIL_PASSWORD

# 4. For SMS Setup (Optional):
#    - Sign up at https://semaphore.co/
#    - Get your API key from dashboard
#    - Add it to SEMAPHORE_API_KEY

# 5. Generate secure secrets:
#    - JWT_SECRET: Use a long random string
#    - SESSION_SECRET: Use a different long random string
#    - You can generate them using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ============================================
# NOTES
# ============================================

# - Never commit the .env file to version control
# - Keep your credentials secure
# - Use different secrets for development and production
# - SMS is optional and disabled by default for bulk uploads
# - Email notifications are sent automatically when members are created
