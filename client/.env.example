# API Configuration
# Must match the server's PORT (see server/.env.example) — this is the base
# URL the client calls for every API request.
VITE_API_BASE_URL=http://localhost:5001/api

# ============================================
# SETUP INSTRUCTIONS
# ============================================

# 1. Copy this file to .env:
#    cp .env.example .env

# 2. Update VITE_API_BASE_URL if your server runs on a different host/port.

# ============================================
# NOTES
# ============================================

# - Never commit the .env file to version control
# - Vite only exposes variables prefixed with VITE_ to client code
